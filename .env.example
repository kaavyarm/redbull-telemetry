# Copy this file to .env.local and fill in your Supabase project's values.
# See README.md's "Local development" section for how to get these.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by the Python ingestion pipeline (scripts/ingest_weekend.py),
# never by the frontend. DATABASE_URL is a direct Postgres connection string
# to the Supabase project (Project Settings > Database > Connection string),
# used with the service_role's DB credentials so it bypasses RLS.
# SUPABASE_OWNER_USER_ID is the single dashboard user's auth.users.id --
# every ingested session is written as owned by this user.
DATABASE_URL=
SUPABASE_OWNER_USER_ID=

# Optional observability. Both sides no-op cleanly when unset -- neither the
# Python pipeline nor the frontend requires a Sentry account to run. Use two
# different Sentry projects (or at least DSNs) for frontend vs Python so
# errors aren't mixed across very different stack traces.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
